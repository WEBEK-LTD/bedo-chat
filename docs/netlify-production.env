# Bedo Chat - the Netlify site's server variables (D-36). Easiest: run docs/owner-sql/netlify-variables.sql in the
# Supabase SQL Editor, which makes every line below with the five generated values filled in. Or fill in the 8
# PASTE_ values here by hand, then in Netlify:
# Site configuration -> Environment variables -> Add a variable -> Import from a .env file -> paste -> Import.
# Never commit or send the filled-in copy anywhere else. The site refuses to start while a PASTE_ value is left.
#
# From your password manager (the values you generated in the Supabase SQL Editor):
#   db_password, access_token_secret, otp_hmac_secret, admin_totp_key, settings_encryption_key
# From Supabase -> Project Settings:
#   API Keys -> "Legacy API keys": anon (public) and service_role (secret)
#   JWT Keys -> "Legacy JWT Secret"

DATABASE_URL=postgresql://bedo_api.cspnnzoyuyxjiyhwzgqj:PASTE_db_password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
ACCESS_TOKEN_SECRET=PASTE_access_token_secret
OTP_HMAC_SECRET=PASTE_otp_hmac_secret
ADMIN_TOTP_KEY=PASTE_admin_totp_key
SETTINGS_ENCRYPTION_KEY=PASTE_settings_encryption_key
SUPABASE_URL=https://cspnnzoyuyxjiyhwzgqj.supabase.co
SUPABASE_ANON_KEY=PASTE_anon_key
SUPABASE_SERVICE_ROLE_KEY=PASTE_service_role_key
SUPABASE_JWT_SECRET=PASTE_legacy_jwt_secret

# Optional, iPhone app notifications (D-53, docs/APPS.md section B2). Leave out until the Apple key exists.
# APNS_KEY=   (all of the .p8 file)
# APNS_KEY_ID=
# APNS_TEAM_ID=

# Optional, Android app notifications (D-58, docs/APPS.md section A4). Leave out until the Firebase key exists.
# FCM_SERVICE_ACCOUNT=   (all of the service account .json file)
