# Migration runner - copy to packages/db/.env, or export DATABASE_URL in your shell. SERVER-ONLY.
# Use the table-owner role (e.g. "postgres") over a DIRECT or SESSION-mode connection.
# On Supabase, never use the transaction pooler (port 6543): the runner refuses it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bedo

# Optional: apply migrations from another directory (defaults to supabase/migrations).
# MIGRATIONS_DIR=
