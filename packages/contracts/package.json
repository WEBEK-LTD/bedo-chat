{
  "name": "@bedo/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas shared by the Bedo Chat API, worker and clients; source of the OpenAPI document",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.0.0 || ^9.0.0",
    "zod": "^4.0.0"
  }
}
