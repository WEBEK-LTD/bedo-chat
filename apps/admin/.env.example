# Bedo Chat admin dashboard (public, browser-visible configuration only).
# Never put secrets here: every NEXT_PUBLIC_* value is shipped to the browser.

# Base URL of the Bedo Chat API (admin sign-in and the Phase 2 admin areas).
# Production (D-25): https://bedochat.com/api. The dashboard itself is served under /admin
# (locally http://localhost:3001/admin).
NEXT_PUBLIC_API_URL=http://localhost:4000
