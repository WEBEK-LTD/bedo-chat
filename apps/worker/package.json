{
  "name": "@bedo/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Bedo Chat background worker (NestJS + BullMQ)",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@bedo/config": "workspace:*",
    "@bedo/contracts": "workspace:*",
    "@bedo/db": "workspace:*",
    "@bedo/server-crypto": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "bullmq": "^5.60.0 || ^6.0.0",
    "ioredis": "^5.8.0 || ^6.0.0",
    "kysely": "^0.28.0 || ^0.29.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "pg": "^8.23.0"
  }
}
