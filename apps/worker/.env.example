# Bedo Chat worker - copy to apps/worker/.env for local development.
# Validated at start-up by @bedo/config (workerEnvSchema). SERVER-ONLY.

NODE_ENV=development
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379
# Prefix for background-queue keys; must match the API's value.
QUEUE_PREFIX=bedo
WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL_MS=15000

# ---- Phase 2 ------------------------------------------------------------------------------------
# Same rules as the API: a login role that is a member of bedo_runtime in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bedo
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Verification codes are sent through Waabek WhatsApp (D-05). The Waabek API key is NOT an environment
# variable (D-32): a Super Admin sets it from the Admin Dashboard and it is stored encrypted in the
# database. The worker refuses to start if WAABEK_API_KEY is set.
OTP_DELIVERY=waabek
# WAABEK_API_URL=https://waabek.com/api/v1/send
# Decrypts the Dashboard-managed Waabek key: the same value as the API's SETTINGS_ENCRYPTION_KEY
# (exactly 32 bytes, base64). Infrastructure only.
SETTINGS_ENCRYPTION_KEY=

# Web Push (D-21). Generate the pair once with `npx web-push generate-vapid-keys`. The private key is
# a secret; the public key also goes into the API's VAPID_PUBLIC_KEY. Subject: mailto: or https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
