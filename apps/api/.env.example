# Bedo Chat API - copy to apps/api/.env for local development.
# All values are read and validated at start-up by @bedo/config (apiEnvSchema).
# SERVER-ONLY: none of these values may ever be copied into a web or admin app.

NODE_ENV=development
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=4000
# Number of reverse proxies / load balancers in front of the API (0 = none). Set it to the real
# count in production; it decides which X-Forwarded-For entry is the client IP.
API_TRUST_PROXY_HOPS=0

# Exact browser origins allowed to call the API (user web app and admin app), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Phase 2: which of those origins is the Admin Dashboard. Admin routes accept only these; the user's
# session cookie is accepted only from the other origins.
ADMIN_ORIGINS=http://localhost:3001
# Phase 2.2 (D-25). Production serves everything from one origin, so set all three origin lists to
# https://bedochat.com, WEB_ORIGINS too (it says which origin the web app uses when it is shared):
#   CORS_ALLOWED_ORIGINS=https://bedochat.com
#   ADMIN_ORIGINS=https://bedochat.com
#   WEB_ORIGINS=https://bedochat.com
#   API_PUBLIC_PATH=/api            (the edge serves the API at https://bedochat.com/api)
#   API_TRUST_PROXY_HOPS=2          (the Cloudflare Worker plus your host's load balancer, if any)
#   EDGE_SECRET=<openssl rand -base64 32>  (also set as the Worker's secret; the API answers only requests
#                                           that carry it, health checks excepted)
# Leave WEB_ORIGINS and API_PUBLIC_PATH empty for local development with separate ports.
WEB_ORIGINS=
API_PUBLIC_PATH=
EDGE_SECRET=

# Production: a login role that is a member of bedo_runtime (see README "Database roles"),
# never the table owner. Locally the Docker Compose superuser is fine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bedo
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Managed Redis in production (use rediss:// for TLS); Docker Compose Redis locally.
REDIS_URL=redis://localhost:6379
# Prefix for background-queue keys; must match the worker's value.
QUEUE_PREFIX=bedo

HEALTH_CHECK_TIMEOUT_MS=2000

# ---- Phase 2: accounts --------------------------------------------------------------------------
# Generate each secret separately, e.g. `openssl rand -base64 32`. Never reuse them across environments.
# Signs the 10-minute access tokens (at least 32 characters).
ACCESS_TOKEN_SECRET=
# Keys the one-time code hashes (at least 32 characters).
OTP_HMAC_SECRET=
# Encrypts admin authenticator secrets at rest: exactly 32 bytes, base64 (`openssl rand -base64 32`).
# The admin-create command needs the same value.
ADMIN_TOTP_KEY=

# Profile pictures in the private Supabase Storage bucket "profile-photos" (P-15). Both or neither;
# without them, profile-picture changes answer "temporarily unavailable".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push public key (D-21), the same value as the worker's VAPID_PUBLIC_KEY. Public by design: the
# browser receives it to subscribe. Leave empty to turn notifications off.
VAPID_PUBLIC_KEY=
