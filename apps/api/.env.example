# Bedo Chat API - copy to apps/api/.env for local development.
# All values are read and validated at start-up by @bedo/config (apiEnvSchema).
# SERVER-ONLY: none of these values may ever be copied into a web or admin app.

NODE_ENV=development
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=4000
# Number of reverse proxies / load balancers in front of the API (0 = none). Set it to the real
# count in production; it decides which X-Forwarded-For entry is the client IP.
API_TRUST_PROXY_HOPS=0

# Exact browser origins allowed to call the API (user web app and admin app), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Production: a login role that is a member of bedo_runtime (see README "Database roles"),
# never the table owner. Locally the Docker Compose superuser is fine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bedo
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Managed Redis in production (use rediss:// for TLS); Docker Compose Redis locally.
REDIS_URL=redis://localhost:6379
# Prefix for background-queue keys; must match the worker's value.
QUEUE_PREFIX=bedo

HEALTH_CHECK_TIMEOUT_MS=2000
