{
  "name": "@bedo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Bedo Chat HTTP API (NestJS on Fastify)",
  "type": "module",
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/scripts/generate-openapi.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "openapi": "node dist/scripts/generate-openapi.js"
  },
  "dependencies": {
    "@bedo/config": "workspace:*",
    "@bedo/contracts": "workspace:*",
    "@bedo/db": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.0 || ^6.0.0",
    "kysely": "^0.28.0 || ^0.29.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.0"
  }
}
