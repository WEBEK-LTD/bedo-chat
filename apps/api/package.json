{
  "name": "@bedo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Bedo Chat API (NestJS on Fastify), served by the website at /api (D-36)",
  "type": "module",
  "files": [
    "dist",
    "openapi",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/scripts/generate-openapi.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "openapi": "node dist/scripts/generate-openapi.js",
    "admin:create": "node --env-file-if-exists=.env dist/scripts/admin-create.js",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@bedo/config": "workspace:*",
    "@bedo/contracts": "workspace:*",
    "@bedo/db": "workspace:*",
    "@bedo/server-crypto": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "@node-rs/argon2": "^2.2.1",
    "@node-rs/bcrypt": "^1.10.9",
    "@supabase/storage-js": "^2.116.0",
    "fastify": "^5.6.0",
    "jose": "^6.2.12",
    "kysely": "^0.28.0 || ^0.29.0",
    "libphonenumber-js": "^1.13.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "pg": "^8.23.0"
  },
  "exports": {
    "./serverless": {
      "types": "./dist/serverless.d.ts",
      "default": "./dist/serverless.js"
    }
  }
}
