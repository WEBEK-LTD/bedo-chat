# Bedo Chat web app (public, browser-visible configuration only).
# Never put secrets here: every NEXT_PUBLIC_* value is shipped to the browser.
# Server-only variables (DATABASE_URL, REDIS_URL, WAABEK_API_KEY) must never appear in this file.

# Base URL of the Bedo Chat API, used from Phase 2 onward. Production (D-25): https://bedochat.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000

# Phase 3 (D-31): the Supabase project URL that serves profile pictures, e.g. https://<project>.supabase.co
# (the API's SUPABASE_URL; public, not a secret). The Content-Security-Policy allows pictures and their upload
# from this origin only. Leave empty when profile pictures are not set up.
NEXT_PUBLIC_STORAGE_ORIGIN=
