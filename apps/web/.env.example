# Bedo Chat website (D-36): the student web app, the Admin Dashboard under /admin and the API under /api.
# Copy to apps/web/.env.local for local development (ignored by git). In production these are the Netlify site's
# environment variables (docs/DEPLOYMENT.md, section 2).

# ---- Public (built into the pages) -----------------------------------------------------------------------------
# The Supabase project URL (https://<project>.supabase.co, the same as SUPABASE_URL). The Content-Security-Policy
# allows profile pictures, their upload and the realtime WebSocket from this exact origin only (D-31, D-36).
# Leave empty when the project's Storage and Realtime are not used locally.
NEXT_PUBLIC_STORAGE_ORIGIN=

# ---- Server only: read by the API inside the site's server functions; never shown to a browser ----------------
NODE_ENV=development
LOG_LEVEL=info

# A login role that is a member of bedo_runtime (README "Database roles"), never the table owner in production.
# Production on Supabase: the transaction pooler (port 6543) as bedo_api.<project-ref>. Locally the Docker Compose
# superuser is fine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bedo
# Connections per server instance (default 3).
DATABASE_POOL_MAX=3
DATABASE_STATEMENT_TIMEOUT_MS=15000
HEALTH_CHECK_TIMEOUT_MS=2000

# Generate each secret separately, e.g. `openssl rand -base64 48`. Never reuse them across environments.
# Signs the 10-minute access tokens and names each device's realtime channel (at least 32 characters).
ACCESS_TOKEN_SECRET=
# Keys the one-time code hashes (at least 32 characters).
OTP_HMAC_SECRET=
# Encrypts admin authenticator secrets at rest: exactly 32 bytes, base64 (`openssl rand -base64 32`).
ADMIN_TOTP_KEY=
# Encrypts the Waabek API key that Super Admins set from the Admin Dashboard (D-32): exactly 32 bytes, base64,
# different from ADMIN_TOTP_KEY. Infrastructure only: never in the database, never in a browser.
SETTINGS_ENCRYPTION_KEY=

# Supabase: profile pictures (P-15) and realtime signals (D-36). The service key is a secret; the anon key is
# public (signed-in browsers receive it to listen on their own channel). URL and service key both or neither.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# The project's legacy JWT secret (Project Settings -> JWT Keys): signs each device's token for its private
# realtime channel. Required with SUPABASE_ANON_KEY. Secret.
SUPABASE_JWT_SECRET=

# Web Push (D-21): leave unset; the API makes and keeps its own keys (D-46). All three set replace them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
