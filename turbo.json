{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.base.json"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "openapi/**"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "WAABEK_API_KEY",
        "ACCESS_TOKEN_SECRET",
        "OTP_HMAC_SECRET",
        "ADMIN_TOTP_KEY",
        "SETTINGS_ENCRYPTION_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_JWT_SECRET",
        "VAPID_PRIVATE_KEY"
      ]
    },
    "@bedo/admin#build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "WAABEK_API_KEY",
        "ACCESS_TOKEN_SECRET",
        "OTP_HMAC_SECRET",
        "ADMIN_TOTP_KEY",
        "SETTINGS_ENCRYPTION_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_JWT_SECRET",
        "VAPID_PRIVATE_KEY"
      ],
      "cache": false
    },
    "@bedo/web#build": {
      "dependsOn": [
        "^build",
        "@bedo/admin#build"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "WAABEK_API_KEY",
        "ACCESS_TOKEN_SECRET",
        "OTP_HMAC_SECRET",
        "ADMIN_TOTP_KEY",
        "SETTINGS_ENCRYPTION_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_JWT_SECRET",
        "VAPID_PRIVATE_KEY"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "TEST_DATABASE_URL"
      ]
    }
  }
}
